APP_NAME="Serenity GO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# APP_URL untuk akses lokal. Saat ngrok dipakai, request publik mengikuti proxy headers.
APP_URL=http://127.0.0.1:8001

# IP reverse proxy yang boleh memasok X-Forwarded-* headers.
# Dibaca saat request, bukan dalam bootstrap/app.php.
# Ngrok lokal biasanya memakai loopback; isi IP/CIDR spesifik untuk proxy lain.
# Jangan gunakan TRUSTED_PROXIES=* pada server yang bisa diakses langsung.
TRUSTED_PROXIES=127.0.0.1,::1
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=serenity_go
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
FILESYSTEM_DISK=local

# Wajib diisi untuk membuat akun Owner. Password minimal 12 karakter.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME="Serenity Owner"

# Opsional, HANYA untuk database development (APP_ENV=local/testing).
# Jalankan `php artisan migrate --seed` setelah true, lalu ubah ke false.
SEED_DEMO_DATA=false
